{
  "name": "simplebot",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "A self-hosted conversation engine with persistent context and explicit tools.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.27.1+sha512.a81d4c21b9b09a4b0aebf90ef5e527d4262bdda322d26082978cb549023ac6d9cafc98b19fffaa5c71db438a65f70224edb78d7311187861ff96480d1cdca23c",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11.9 <12"
  },
  "scripts": {
    "build": "pnpm -r --aggregate-output build",
    "package": "pnpm legal:check && pnpm build && node --import tsx server/scripts/package.ts",
    "auth:pair": "node bin/simplebot.js pair",
    "auth:key": "node bin/simplebot.js pair key",
    "backup": "node bin/simplebot.js backup",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm legal:check && pnpm export:check && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "node bin/simplebot.js doctor",
    "lint": "pnpm --filter @simplebot/shared build && eslint .",
    "restore": "node bin/simplebot.js restore",
    "pretest": "pnpm --filter @simplebot/shared build",
    "test": "pnpm -r --parallel --aggregate-output test",
    "test:acceptance": "pnpm build && playwright test",
    "screens": "node --import tsx server/scripts/screens.ts",
    "typecheck": "pnpm --filter @simplebot/shared build && pnpm -r --parallel --aggregate-output typecheck && tsc --noEmit",
    "legal:notices": "node --import tsx server/scripts/notices.ts",
    "export:public": "node --import tsx server/scripts/export.ts",
    "export:check": "node --import tsx server/scripts/export.ts --check",
    "legal:check": "node --import tsx server/scripts/notices.ts --check",
    "package:brew": "node --import tsx server/scripts/homebrew.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huglyfe/simplebot.git"
  },
  "homepage": "https://github.com/huglyfe/simplebot",
  "bugs": {
    "url": "https://github.com/huglyfe/simplebot/issues"
  },
  "author": "huglyfe"
}
